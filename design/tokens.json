{
  "meta": {
    "name": "laf-dark-graphite",
    "version": "0.1.0",
    "description": "Local AI Video Factory core design tokens. Dark-first, restrained, trust-oriented. Light theme derives from the same semantic slots. Single source of truth: docs/DESIGN-SYSTEM.md documents usage rules.",
    "grid": 4,
    "compileTargets": ["tailwind-theme", "css-variables"]
  },
  "color": {
    "bg": {
      "base": "#0F1115",
      "surface": "#151922",
      "elevated": "#1B212E",
      "overlay": "#212A3B"
    },
    "border": {
      "subtle": "#232B3B",
      "default": "#2E3947",
      "strong": "#405066"
    },
    "text": {
      "primary": "#E7EBF3",
      "secondary": "#9BA6B7",
      "muted": "#6B7688",
      "onAccent": "#06231F"
    },
    "accent": {
      "default": "#2DD4BF",
      "hover": "#5EEAD4",
      "pressed": "#0FA593",
      "subtle": "#103B36",
      "focusRing": "#2DD4BF"
    },
    "semantic": {
      "success": "#3DDC97",
      "successSubtle": "#0E2E22",
      "warning": "#F5C04E",
      "warningSubtle": "#33270D",
      "danger": "#F2707A",
      "dangerSubtle": "#36181C",
      "info": "#6AA6F8",
      "infoSubtle": "#14263D"
    },
    "chart": {
      "series": ["#2DD4BF", "#6AA6F8", "#F5C04E", "#F2707A", "#B79BF5", "#3DDC97", "#F49AC1"]
    }
  },
  "typography": {
    "ui": "Inter",
    "mono": "JetBrains Mono",
    "licensing": "Both fonts under SIL OFL 1.1, bundled via @fontsource in Phase 2; no runtime web fetch.",
    "scale": {
      "caption": { "size": 12, "weight": 500, "lineHeight": 16 },
      "body2": { "size": 13, "weight": 400, "lineHeight": 18 },
      "body": { "size": 14, "weight": 400, "lineHeight": 20 },
      "section": { "size": 16, "weight": 600, "lineHeight": 22 },
      "pageTitle": { "size": 20, "weight": 600, "lineHeight": 28 },
      "display": { "size": 26, "weight": 600, "lineHeight": 32 }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 14,
    "full": 999
  },
  "density": {
    "tableRowHeight": 36,
    "controlHeight": 32,
    "controlHeightComfortable": 40
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "280ms",
    "ease": "cubic-bezier(0.2, 0.7, 0.3, 1)",
    "reducedMotion": "respect prefers-reduced-motion; disable non-essential animation"
  }
}
