# ============================================================
# Local AI Video Factory - environment template
#
# Core features run with NO environment variables at all.
# Copy to .env only if you enable optional integrations.
# Every value here MUST stay empty in this template.
# NEVER put real secrets in .env or commit it - OAuth client
# secrets will live in Windows Credential Manager (Phase 10+).
# ============================================================

# --- Optional: YouTube Data API (Phase 10) ---
# Path to the OAuth *desktop client* JSON downloaded from Google Cloud Console.
# The file itself must live OUTSIDE the repository.
# GOOGLE_OAUTH_CLIENT_FILE=

# --- Optional: Instagram / Meta Graph API (Phase 11) ---
# App ID only. The app secret is stored via Windows Credential Manager, never here.
# META_APP_ID=

# --- Optional: storage location overrides ---
# LAF_DATA_DIR=
# LAF_MODELS_DIR=

# --- Optional: local runtime overrides ---
# LAF_OLLAMA_HOST=
# LAF_LOG_LEVEL=
